{
  "name": "smart-water-treatment-ai-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"tsx watch server/src/index.ts\"",
    "dev:e2e": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "serve:built": "pnpm run build && tsx server/src/index.ts",
    "serve:e2e": "pnpm run build && pnpm run serve:e2e:express",
    "serve:e2e:express": "tsx e2e/server.ts",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "test:server": "vitest server/tests --run",
    "test:e2e": "playwright test",
    "test:e2e:mocked": "playwright test --project=mocked",
    "test:e2e:integration": "playwright test --project=integration",
    "generate:data": "tsx scripts/generate-demo-workbook.ts",
    "generate:wphi": "tsx scripts/generate-wphi-workbook.ts"
  },
  "dependencies": {
    "@alicloud/pop-core": "^1.8.0",
    "@gsap/react": "^2.1.2",
    "alibabacloud-nls": "1.0.4",
    "d3": "^7.9.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sherpa-onnx-node": "^1.13.6",
    "three": "^0.180.0",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
